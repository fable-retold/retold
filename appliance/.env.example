# Copy to .env (same folder as docker-compose.yml) and fill in.
#
# GH_TOKEN is a READ-ONLY fine-grained Personal Access Token:
#   Resource owner:     stevenvelozo
#   Repository access:  the private foundation repos (or All repositories)
#   Permissions:        Repository -> Contents: Read-only   (+ auto Metadata: Read)
# Create it at https://github.com/settings/personal-access-tokens/new
# Public fable-retold modules need no token; this only unlocks the private ones for read-only checkout.

GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
